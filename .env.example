# SMTP credentials for the contact form (Next.js API route + Nodemailer)
# TODO: Configure with client's actual email provider + credentials
# NOTE: without SMTP_HOST/SMTP_USER/SMTP_PASS set, the API route accepts the
# form and logs it but sends nothing — the user still sees a success message.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# Inquiry inbox. Optional — the route already defaults to info@wecan-bg.com.
CONTACT_TO_EMAIL=info@wecan-bg.com
# Envelope sender. Must be a domain your SMTP provider is authorised to send
# for; defaults to SMTP_USER when unset.
CONTACT_FROM_EMAIL=website@wecan-bg.com
